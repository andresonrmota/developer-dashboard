# Config pública do app web do Firebase (Console → Configurações do projeto → Seus apps).
# Copie para .env.local. Sem isso o dev server não conecta ao Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# UID do owner (o mesmo que está em firestore.rules). É o que libera edição e o botão "Mapear projetos".
VITE_OWNER_UID=
